<?xml version="1.0" encoding="UTF-8"?>
<!--
    MageOS_DashboardChart: dashboard chart definitions (per file schema).
    Files: etc/dashboard_charts.xml of any module, merged by section/@id and chart/@id.
    Optional: charts are generated from the MageOS_AdvancedReport presets (report_datasets.xml); this file
    declares the dashboard sections and overrides or adds charts.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
    <xs:element name="config">
        <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
                <xs:element name="section" type="sectionType"/>
                <xs:element name="chart" type="chartType"/>
            </xs:choice>
        </xs:complexType>
        <xs:unique name="uniqueSectionId">
            <xs:selector xpath="section"/>
            <xs:field xpath="@id"/>
        </xs:unique>
    </xs:element>

    <xs:complexType name="sectionType">
        <xs:sequence>
            <xs:element name="acl" type="aclType" minOccurs="0"/>
        </xs:sequence>
        <xs:attribute name="id" type="codeType" use="required"/>
        <xs:attribute name="label" type="xs:string" use="optional"/>
        <xs:attribute name="sortOrder" type="xs:int" use="optional"/>
        <xs:attribute name="disabled" type="xs:boolean" use="optional"/>
    </xs:complexType>

    <xs:complexType name="chartType">
        <xs:annotation>
            <xs:documentation>
                A chart over an Advanced Report preset. Every preset of report_datasets.xml already gets a generated
                chart (id = preset code, section = preset area, type, metrics, dimension and sort from the chart of the
                preset, limit 10): a chart element with that id overrides it, a chart with another id adds a second
                chart on "preset" (default: the id), disabled="true" removes it.
                metric/dimension children replace the preset ones. Metrics sharing a format (money, integer...)
                are drawn together; the dashboard switches between formats (never two value axes).
            </xs:documentation>
        </xs:annotation>
        <xs:sequence>
            <xs:element name="description" type="xs:string" minOccurs="0"/>
            <xs:element name="acl" type="aclType" minOccurs="0"/>
            <xs:element name="metric" type="metricType" minOccurs="0" maxOccurs="unbounded"/>
            <xs:element name="dimension" type="dimensionType" minOccurs="0" maxOccurs="unbounded"/>
        </xs:sequence>
        <xs:attribute name="id" type="codeType" use="required"/>
        <xs:attribute name="preset" type="codeType" use="optional"/>
        <xs:attribute name="section" type="codeType" use="optional"/>
        <xs:attribute name="label" type="xs:string" use="optional"/>
        <xs:attribute name="type" type="chartTypeType" use="optional"/>
        <xs:attribute name="size" type="sizeType" use="optional"/>
        <xs:attribute name="limit" type="xs:positiveInteger" use="optional"/>
        <xs:attribute name="dateRange" type="dateRangeType" use="optional"/>
        <xs:attribute name="compareTo" type="compareToType" use="optional"/>
        <xs:attribute name="sortBy" type="codeType" use="optional"/>
        <xs:attribute name="sortDirection" type="directionType" use="optional"/>
        <xs:attribute name="sortOrder" type="xs:int" use="optional"/>
        <xs:attribute name="disabled" type="xs:boolean" use="optional"/>
    </xs:complexType>

    <xs:complexType name="aclType">
        <xs:annotation>
            <xs:documentation>
                ACL of a section or chart. "resource" is required in addition to the parent's resources when
                "inherit" is true (default): a chart inherits its section, a section inherits the root resource
                MageOS_DashboardChart::charts. With inherit="false" only "resource" is checked at this level.
                The Advanced Report dataset ACL (module + core resource) is always required.
            </xs:documentation>
        </xs:annotation>
        <xs:attribute name="resource" type="aclResourceType" use="optional"/>
        <xs:attribute name="inherit" type="xs:boolean" use="optional" default="true"/>
    </xs:complexType>

    <xs:simpleType name="aclResourceType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[A-Z]+[A-Za-z0-9]{1,}_[A-Z]+[A-Za-z0-9]{1,}::[A-Za-z_0-9]{1,}"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="codeType">
        <xs:restriction base="xs:string">
            <xs:pattern value="[a-z0-9_{}]+"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="chartTypeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="line"/>
            <xs:enumeration value="bar"/>
            <xs:enumeration value="horizontalBar"/>
            <xs:enumeration value="doughnut"/>
            <xs:enumeration value="pie"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="sizeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="half"/>
            <xs:enumeration value="full"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="dateRangeType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="today"/>
            <xs:enumeration value="last_7_days"/>
            <xs:enumeration value="last_30_days"/>
            <xs:enumeration value="month_to_date"/>
            <xs:enumeration value="last_month"/>
            <xs:enumeration value="year_to_date"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="compareToType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="none"/>
            <xs:enumeration value="previous_period"/>
            <xs:enumeration value="previous_year"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="granularityType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="hour"/>
            <xs:enumeration value="day"/>
            <xs:enumeration value="week"/>
            <xs:enumeration value="month"/>
            <xs:enumeration value="year"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:simpleType name="directionType">
        <xs:restriction base="xs:string">
            <xs:enumeration value="asc"/>
            <xs:enumeration value="desc"/>
        </xs:restriction>
    </xs:simpleType>

    <xs:complexType name="metricType">
        <xs:attribute name="code" type="codeType" use="required"/>
        <xs:attribute name="remove" type="xs:boolean" use="optional"/>
    </xs:complexType>

    <xs:complexType name="dimensionType">
        <xs:attribute name="code" type="codeType" use="required"/>
        <xs:attribute name="granularity" type="granularityType" use="optional"/>
        <xs:attribute name="remove" type="xs:boolean" use="optional"/>
    </xs:complexType>
</xs:schema>
